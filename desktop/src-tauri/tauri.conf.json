{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoClaw",
  "version": "0.1.0",
  "identifier": "com.nanoclaw.desktop",
  "build": {
    "frontendDist": "../static",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NanoClaw",
        "url": "index.html",
        "width": 900,
        "height": 700,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Productivity",
    "shortDescription": "Local browser chat for NanoClaw",
    "longDescription": "Desktop wrapper around the NanoClaw local-http channel. Loads http://127.0.0.1:3030 in a native window."
  }
}
